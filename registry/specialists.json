    {
      "id": "mych-pixel-art",
      "display_name": "Professional Pixel Art",
      "path": "specialists/mych-pixel-art",
      "version": "2.0.0",
      "status": "tested",
      "summary": "Sprites, tilesets, palettes, animation and sprite sheets, with a standard-library PNG toolchain.",
      "triggers": [
        "pixel art",
        "sprite",
        "sprites",
        "sprite sheet",
        "spritesheet",
        "tileset",
        "tile set",
        "tilemap",
        "palette",
        "dithering",
        "8-bit",
        "16-bit",
        "retro",
        "pixel animation",
        "platformer",
        "2d game"
      ],
      "avoid": [
        "photorealistic",
        "3d model",
        "vector icon"
      ],
      "requires": [
        "python3"
      ],
      "optional": [
        "aseprite|libresprite",
        "module:PIL",
        "convert|magick"
      ],
      "live_capability": null,
      "scripts": [
        {
          "path": "scripts/pixel_tool.py",
          "purpose": "PNG codec, text-sprite renderer, sheet packer with Aseprite-style JSON, validator, palettes, scaling"
        }
      ],
      "tests": [
        "tests/test_spec_pixel_art.py"
      ],
      "tools": [
        {
          "name": "mych_pixel_render",
          "description": "Render a text sprite file to PNG frames or to a sprite sheet with Aseprite-style JSON metadata (frames, durations, tags, anchor).",
          "parameters": {
            "type": "object",
            "properties": {
              "sprite": {
                "type": "string",
                "description": "Path to the .sprite text file, relative to the workspace."
              },
              "out": {
                "type": "string",
                "description": "Output folder, relative to the workspace."
              },
              "sheet": {
                "type": "boolean",
                "description": "Write one sheet PNG plus JSON instead of one PNG per frame."
              },
              "scale": {
                "type": "integer",
                "description": "Integer upscale for previews (ship 1x).",
                "minimum": 1,
                "maximum": 64
              }
            },
            "required": [
              "sprite",
              "out"
            ]
          },
          "command": [
            "{python}",
            {
              "skill": "mych-pixel-art",
              "path": "scripts/pixel_tool.py"
            },
            "render",
            {
              "param": "sprite"
            },
            "--out",
            {
              "param": "out"
            },
            {
              "flag": "--sheet",
              "when": "sheet"
            },
            {
              "option": "--scale",
              "param": "scale"
            }
          ],
          "path_params": [
            "sprite",
            "out"
          ],
          "read_only": false
        },
        {
          "name": "mych_pixel_validate",
          "description": "Check a PNG against pixel-art rules: palette membership, color limit, semi-transparency, cell alignment and isolated pixels. Read-only.",
          "parameters": {
            "type": "object",
            "properties": {
              "png": {
                "type": "string",
                "description": "PNG path relative to the workspace."
              },
              "palette": {
                "type": "string",
                "description": "Built-in palette name (pico8, sweetie16, gameboy, grayscale4) or a palette file path."
              },
              "max_colors": {
                "type": "integer",
                "description": "Maximum number of opaque colors.",
                "minimum": 1
              },
              "cell": {
                "type": "string",
                "description": "Frame or tile size such as 16x16."
              }
            },
            "required": [
              "png"
            ]
          },
          "command": [
            "{python}",
            {
              "skill": "mych-pixel-art",
              "path": "scripts/pixel_tool.py"
            },
            "validate",
            {
              "param": "png"
            },
            "--json",
            {
              "option": "--palette",
              "param": "palette"
            },
            {
              "option": "--max-colors",
              "param": "max_colors"
            },
            {
              "option": "--cell",
              "param": "cell"
            }
          ],
          "path_params": [
            "png",
            "palette"
          ],
          "read_only": true
        }
      ]
    },
